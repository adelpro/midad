# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.yarn/
.pnp.*

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo
.cache/

# local EAS build artifacts (eas build --local --output builds/...)
builds/

# verification caches (see AGENTS.md "Checks")
.eslintcache
.prettiercache

# inline plan-execution scratch (ledger, briefs, review packages)
.superpowers/
docs/superpowers/*
# ...but the dated design specs and plans are durable records, not scratch,
# and must be tracked. Re-include the directories (not just the files) so git
# descends into them; a `!docs/superpowers/plans/*.md` alone would not work.
!docs/superpowers/specs/
!docs/superpowers/plans/

# generated native folders
/ios
/android

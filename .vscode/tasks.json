{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check cluster segmentation",
      "type": "shell",
      "command": "node scripts/check-clusters.mjs",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Check group membership",
      "type": "shell",
      "command": "node scripts/check-groups.mjs",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Check handle geometry",
      "type": "shell",
      "command": "node scripts/check-handles.mjs",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Check shortcut bindings",
      "type": "shell",
      "command": "node scripts/check-shortcuts.mjs",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Typecheck",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "problemMatcher": ["$tsc"],
      "group": "build"
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "npx eslint src scripts --cache --cache-location .eslintcache",
      "problemMatcher": ["$eslint-stylish"],
      "group": "build"
    },
    {
      "label": "Check help coverage",
      "type": "shell",
      "command": "node scripts/check-help.mjs",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Verify (all)",
      "type": "shell",
      "command": "node scripts/verify.mjs",
      "problemMatcher": ["$tsc", "$eslint-stylish"],
      "group": "test"
    }
  ]
}

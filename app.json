{
  "expo": {
    "name": "midad",
    "slug": "midad",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "midad",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.adelpro.midad",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": ["ar", "en"],
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "supportsRTL": true,
      "adaptiveIcon": {
        "backgroundColor": "#F7F6F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.adelpro.midad",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#111111"
          }
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم التطبيق مكتبة الصور لاختيار صورة خلفية للتصميم / The app uses your photo library to choose a design background image."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "يستخدم التطبيق مكتبة الصور لاختيار صورة خلفية للتصميم / The app uses your photo library to choose a design background image.",
          "savePhotosPermission": "يستخدم التطبيق مكتبة الصور لحفظ تصميماتك / The app saves your designs to your photo library.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

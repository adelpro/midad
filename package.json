{
  "name": "midad",
  "main": "expo-router/entry",
  "version": "0.6.0-rc.2",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "fflate": "^0.8.3",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "docs:start": "cd docs && npx fumapress",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "android:build:apk": "eas build -p android --profile apk",
    "android:build:aab": "eas build -p android --profile aab",
    "android:build:apk:local": "eas build -p android --profile apk --local --output builds/app.apk",
    "android:build:aab:local": "eas build -p android --profile aab --local --output builds/app.aab",
    "android:submit:internal": "eas submit -p android --profile production --latest",
    "android:build-submit:internal:local": "yarn android:build:aab:local && yarn android:submit:internal",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --cache --cache-location .eslintcache",
    "lint:fix": "eslint src scripts --cache --cache-location .eslintcache --fix",
    "format": "prettier --check . --cache --cache-location .prettiercache",
    "format:fix": "prettier --write . --cache --cache-location .prettiercache",
    "format:check": "prettier --check . --cache --cache-location .prettiercache",
    "type-check": "tsc --noEmit",
    "build:check": "expo export --platform web",
    "secrets:check": "gitleaks protect --staged --redact",
    "prepare": "husky",
    "verify": "node scripts/verify.mjs",
    "eas-build-pre-install": "corepack enable && corepack prepare yarn@4.13.0 --activate"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}

{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "aab": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    },
    "preview": {
      "extends": "apk"
    },
    "production": {
      "extends": "aab",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}

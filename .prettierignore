# Prettier does not read .gitignore — only node_modules is excluded for free.
# Everything listed here is generated, native or binary, and leaving it off the
# list is what makes `prettier --write .` walk the whole prebuild tree.

# Generated native projects (gitignored, thousands of files)
android/
ios/
dist/
.expo/

node_modules/
public/

# Locks and binary assets
yarn.lock
assets/fonts/

# Superpowers design specs and plans. Tracked records now (.gitignore re-includes
# them), not scratch - but they are the skill's prose, so keep them out of the
# app's format gate rather than reformatting them.
docs/superpowers/

# Agent tooling state (gitignored via its own nested .gitignore, which prettier
# does not read - so without this it walks in and fails the format gate)
.opencode/

# /brag launch-video output: generated media, a vendored GSAP bundle and the
# composition's own scratch. Same trap as .opencode/ - untracked and generated,
# so prettier would otherwise walk in and fail the gate on every run.
brag-output/

# Verification caches (see AGENTS.md "Checks")
*.tsbuildinfo
.eslintcache
.prettiercache
.cache/
